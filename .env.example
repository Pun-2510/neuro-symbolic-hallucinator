# =====================================================================
# Essay Integrity Checker - environment variables
# Copy to `.env` and fill in real values. DO NOT commit `.env` to git.
# =====================================================================

# --- App ---
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO
JWT_SECRET=change-me-in-production-use-env-var

# --- Database ---
DATABASE_URL=sqlite:///./data/app.db

# --- API paths (override defaults in config.yaml) ---
# CROSSREF_BASE_URL=https://api.crossref.org
# OPENALEX_BASE_URL=https://api.openalex.org
# DBLP_BASE_URL=https://dblp.org/search/publ/api
# ARXIV_BASE_URL=https://export.arxiv.org/api/query
# OPENLIBRARY_BASE_URL=https://openlibrary.org
# EUROPEPMC_BASE_URL=https://www.ebi.ac.uk/europepmc/webservices/rest

# --- Polite pool email (sent via User-Agent to Crossref/OpenAlex/DBLP) ---
CONTACT_EMAIL=noreply@citra.edu.vn

# --- Scholarly API keys (optional, increases rate limits) ---
OPENALEX_API_KEY=
CROSSREF_API_KEY=
SERPAPI_API_KEY=
S2_API_KEY=
COREAPI_API_KEY=

# --- Thresholds (override defaults in config.yaml) ---
# ABSTENTION_LOW=0.4
# ABSTENTION_HIGH=0.6
# TITLE_SIM_VERIFIED=0.9
# TITLE_SIM_METADATA_ERROR=0.6

# --- Paths ---
DATA_DIR=./data
CACHE_DIR=./data/cache
CONFIG_FILE=./configs/config.yaml

# --- Email / SMTP (Account Activation & Password Reset) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME="CITRA - Academic Source Verification"
FRONTEND_URL=http://localhost:5173

# --- Google OAuth2 (Sign in with Google) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
