# ACL Anthology source checkout — 1.1 GB external clone, fetched separately.
# Obtain with: git clone https://github.com/acl-org/acl-anthology.git data/acl_data
data/acl_data/
data/*.bak
data/*.truncated.bak
# ACL Anthology BibTeX is a 73 MB download — regenerate with
# `python -c "from scripts.import_acl_anthology import download_acl_anthology; download_acl_anthology(__import__('pathlib').Path('data/acl_anthology.bib'))"`
data/acl_anthology.bib
logs/

